        {
          "id": "report",
          "text": "Сообщаю начальнику поезда",
          "review": {
            "verdict": "best",
            "topic": "safety.evacuation",
            "explanation": "Первым делом информируется начальник поезда."
          },
          "next": "situation-start"
        },
        {
          "id": "run",
          "text": "Бегу смотреть, что случилось",
          "review": {
            "verdict": "bad",
            "topic": "safety.evacuation",
