        "metersVisible": true
      },
      "speaker": "author",
      "text": "Из соседнего вагона тянет дымом. К вам подбегает пассажир.",
      "next": "passenger-asks"
    },
    "passenger-asks": {
      "type": "choice",
      "speaker": "passenger-oleg",
      "text": "Что происходит?! Мы горим?!",
      "timeLimitSec": 20,
      "options": [
        {
