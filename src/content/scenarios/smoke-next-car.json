            { "meter": "loyalty", "delta": 10 },
            { "meter": "safety", "delta": 5 }
          ],
          "review": {
            "verdict": "best",
            "topic": "communication.calm",
            "explanation": "Спокойный тон снижает панику."
          },
          "next": "announce"
        },
        {
          "id": "shout",
          "text": "Не мешайте! Отойдите!",
          "effects": [{ "meter": "loyalty", "delta": -30 }],
          "review": {
            "verdict": "bad",
            "topic": "communication.calm",
            "explanation": "Грубость усиливает панику в вагоне."
          },
          "next": "announce"
        },
        {
          "id": "escort",
          "text": "Проводите меня к очагу, покажете",
          "if": { "meter": "loyalty", "gte": 50 },
          "effects": [{ "meter": "safety", "delta": -25 }],
          "review": {
            "verdict": "bad",
            "topic": "safety.evacuation",
            "explanation": "Пассажира нельзя вести к источнику опасности."
          },
          "next": "announce"
        }
      ]
    },
    "announce": {
      "type": "choice",
      "speaker": "author",
      "text": "Что объявить пассажирам по громкой связи?",
      "options": [
        {
          "id": "evacuate",
          "text": "Объявляю эвакуацию из соседнего вагона в другую часть состава",
          "effects": [{ "flag": "evacuationAnnounced", "value": true }],
          "review": {
            "verdict": "best",
            "topic": "safety.evacuation",
            "explanation": "Чёткое объявление эвакуации даёт пассажирам ясные и своевременные инструкции."
          },
          "next": "resolution"
        },
        {
          "id": "reassure-only",
          "text": "Прошу сохранять спокойствие, скоро всё разъяснится",
          "review": {
            "verdict": "bad",
            "topic": "safety.evacuation",
            "explanation": "Без объявления эвакуации пассажиры не поймут, что делать и куда идти."
          },
          "next": "resolution"
        }
      ]
    },
    "resolution": {
      "type": "line",
      "speaker": "author",
      "text": "Объявление сделано. Вагон реагирует по-разному.",
      "next": [
        { "if": { "meter": "loyalty", "lt": 40 }, "to": "end-tense" },
        { "to": "end-calm" }
      ]
    },
    "end-calm": {
      "type": "end",
      "speaker": "mentor-anna",
      "text": "Хорошая работа."
    },
    "end-tense": {
      "type": "end",
      "speaker": "mentor-anna",
      "text": "Вагон вас не слушал.",
      "result": "failed"
    }
