# Единственный env-файл проекта. Его читают Vite (переменные VITE_*) и
# docker compose (подстановка ${...} в docker-compose.yml).

# Порт хоста для docker compose; контейнер nginx слушает 8080
CLIENT_PORT=3000

# Базовый URL API. Вшивается в бандл на этапе сборки (vite build)
VITE_API_URL=http://localhost:5000/api/
